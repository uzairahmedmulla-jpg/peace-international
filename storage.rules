rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Invoice PDFs: only signed-in users can access.
    // Tip: enable Firebase App Check and/or require a custom admin claim
    // for stricter access in production.
    match /invoices/{fileName} {
      allow read, write: if request.auth != null;
    }
  }
}
